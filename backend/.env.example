# Invictus Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection (Option 1: Full Connection String - recommended for Render/Neon/Supabase)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invictus_db

# Database Connection (Option 2: Individual Parameters)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=invictus_db
DB_PASSWORD=postgres
DB_PORT=5432

# Authentication Secret (Generate a strong random 256-bit key for production)
JWT_SECRET=invictus_secure_jwt_secret_change_in_production_2026
